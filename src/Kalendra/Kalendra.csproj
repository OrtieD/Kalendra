<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Kalendra</AssemblyName>
    <RootNamespace>Kalendra</RootNamespace>
    <Version>1.1.1</Version>
    <ApplicationIcon>Assets/kalendra.ico</ApplicationIcon>
    <Company>Kalendra</Company>
    <Description>Kalendra – Kalender für Windows mit iCloud- und Google-Abgleich</Description>
    <Product>Kalendra</Product>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/kalendra.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
